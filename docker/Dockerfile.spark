# Spark Streaming Job Container
# Used for local testing and custom Dataproc images

FROM gcr.io/spark-operator/spark-py:v3.5.0

USER root

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src/ ./src/

# Set environment variables
ENV PYTHONPATH=/app
ENV PYSPARK_PYTHON=python3
ENV PYSPARK_DRIVER_PYTHON=python3

# Add GCS connector
RUN curl -o /opt/spark/jars/gcs-connector-hadoop3-2.2.0.jar \
    https://storage.googleapis.com/hadoop-lib/gcs/gcs-connector-hadoop3-2.2.0.jar

# Add BigQuery connector
RUN curl -o /opt/spark/jars/spark-bigquery-with-dependencies_2.12-0.32.0.jar \
    https://repo1.maven.org/maven2/com/google/cloud/spark/spark-bigquery-with-dependencies_2.12/0.32.0/spark-bigquery-with-dependencies_2.12-0.32.0.jar

# Default command
ENTRYPOINT ["python", "-m", "src.streaming.spark_streaming"]
