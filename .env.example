# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# Pub/Sub Configuration
PUBSUB_TOPIC=crypto-transactions
PUBSUB_SUBSCRIPTION=crypto-transactions-sub
PUBSUB_DLQ_TOPIC=crypto-transactions-dlq

# BigQuery Configuration
BIGQUERY_DATASET=crypto_pipeline
BIGQUERY_TABLE_TRANSACTIONS=transactions
BIGQUERY_TABLE_AGGREGATES=hourly_aggregates
BIGQUERY_LOCATION=US

# Dataproc Configuration
DATAPROC_CLUSTER=crypto-spark-cluster
DATAPROC_REGION=us-central1
DATAPROC_WORKERS=3
DATAPROC_WORKER_MACHINE_TYPE=n2-standard-4
DATAPROC_MASTER_MACHINE_TYPE=n2-standard-4

# Cloud Storage Configuration
GCS_BUCKET=crypto-pipeline-data
CHECKPOINT_BUCKET=crypto-pipeline-checkpoints
TEMP_BUCKET=crypto-pipeline-temp

# Cloud Composer Configuration
COMPOSER_ENVIRONMENT=crypto-pipeline-composer
COMPOSER_LOCATION=us-central1

# Spark Configuration
SPARK_BATCH_INTERVAL_SECONDS=30
SPARK_CHECKPOINT_INTERVAL=60
SPARK_MAX_OFFSETS_PER_TRIGGER=100000

# Crypto API Configuration (for data ingestion)
CRYPTO_API_URL=wss://stream.binance.com:9443/ws
CRYPTO_SYMBOLS=btcusdt,ethusdt,bnbusdt,adausdt,dogeusdt

# Monitoring
ENABLE_MONITORING=true
ALERT_EMAIL=alerts@example.com
